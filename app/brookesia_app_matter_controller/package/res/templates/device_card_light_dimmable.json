                                "type": "clicked",
                                "action": "device.toggle.light_dimmable"
                            }
                        ],
                        "style": {
                            "bgColor": "#2E2E5A",
                            "borderColor": "#3A3A60",
                            "borderWidth": 1,
                            "radius": 16,
                            "padding": 0
