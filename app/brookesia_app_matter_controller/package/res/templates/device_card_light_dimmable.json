                        "placement": {
                            "mode": "relative",
                            "width": 58,
                            "height": 32
                        },
                        "layout": {
                            "type": "flex",
                            "mainAlign": "center",
                            "crossAlign": "center"
                        },
                        "children": [
                            {
                                "type": "label",
                                "id": "card_power_label",
                                "labelProps": {
                                    "text": "OFF"
                                },
                                "style": {
                                    "textColor": "#EAEAFF",
                                    "fontSize": 11
                                },
                                "bindings": {
                                    "labelProps.text": "text"
                                }
                            }
                        ]
                    }
