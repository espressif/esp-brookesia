                        "layout": {
                            "type": "flex",
                            "mainAlign": "center",
                            "crossAlign": "center"
                        },
                        "children": [
                            {
                                "type": "label",
                                "id": "card_remove_label",
                                "labelProps": {
                                    "text": "Remove"
                                },
                                "style": {
                                    "textColor": "#FFB4C7",
                                    "fontSize": 10
