                                            "bgColor": "#EAEAFF",
                                            "borderColor": "#D7DCE5",
                                            "borderWidth": 1,
                                            "padding": 1,
                                            "radius": 8
                                        },
                                        "stateStyles": {
                                            "pressed": {
                                                "bgColor": "#FFFFFF"
                                            }
                                        }
                                    }
                                },
                                "placement": {
                                    "mode": "relative",
                                    "width": 1,
                                    "height": 16,
                                    "flexGrow": 1
                                }
