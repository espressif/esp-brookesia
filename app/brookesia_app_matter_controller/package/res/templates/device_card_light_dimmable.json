                            {
                                "type": "label",
                                "id": "control_brightness_value",
                                "labelProps": {
                                    "text": "80"
                                },
                                "style": {
                                    "textColor": "#EAEAFF",
                                    "fontSize": 10,
                                    "textAlign": "right"
