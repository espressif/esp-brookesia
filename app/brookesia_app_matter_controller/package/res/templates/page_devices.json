{
    "type": "viewTemplate",
    "id": "page_devices",
    "node": {
        "type": "container",
        "commonProps": {
            "scrollable": false
        },
        "bindings": {
            "commonProps.hidden": "hidden"
        },
        "style": {
            "paddingLeft": 18,
            "paddingRight": 18,
            "paddingTop": 14,
            "paddingBottom": 14
        },
        "placement": {
            "mode": "absolute",
            "align": "topLeft",
            "x": 0,
            "y": 0,
            "width": "match",
            "height": "match"
        },
        "layout": {
            "type": "flex",
            "flexFlow": "column",
            "gap": 12,
            "crossAlign": "stretch"
        },
        "children": [
            {
                "type": "container",
                "id": "page_devices_shell",
                "commonProps": {
                    "scrollable": false,
                    "clickable": false
                },
                "placement": {
                    "mode": "relative",
                    "width": "match",
                    "height": "match"
                },
                "layout": {
                    "type": "flex",
                    "flexFlow": "column",
                    "gap": 12,
                    "crossAlign": "stretch"
                },
                "children": [
                    {
                        "type": "container",
                        "id": "devices_header",
                        "commonProps": {
                            "scrollable": false,
                            "clickable": false
                        },
                        "placement": {
                            "mode": "relative",
                            "width": "match",
                            "height": "wrap"
                        },
                        "layout": {
                            "type": "flex",
                            "flexFlow": "row",
                            "gap": 10,
                            "mainAlign": "spaceBetween",
                            "crossAlign": "center"
                        },
                        "children": [
                            {
                                "type": "container",
                                "id": "devices_heading",
                                "commonProps": {
                                    "scrollable": false,
                                    "clickable": false
                                },
                                "layout": {
                                    "type": "flex",
                                    "flexFlow": "column",
                                    "gap": 2
                                },
                                "children": [
                                    {
                                        "type": "label",
                                        "id": "page_devices_title",
                                        "labelProps": {
                                            "text": "Your Devices"
                                        },
                                        "style": {
                                            "textColor": "#EAEAFF",
                                            "fontSize": 18
                                        },
                                        "bindings": {
                                            "labelProps.text": "labelProps.text"
                                        }
                                    },
                                    {
                                        "type": "label",
                                        "id": "page_devices_count",
                                        "bindings": {
                                            "labelProps.text": "text"
                                        },
                                        "labelProps": {
                                            "text": "0 devices"
                                        },
                                        "style": {
                                            "textColor": "#9292B8",
                                            "fontSize": 11
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "button",
                                "id": "rooms_shortcut",
                                "events": [
                                    {
                                        "type": "clicked",
                                        "action": "nav.rooms"
                                    }
                                ],
                                "style": {
                                    "bgColor": "#2E2E5A",
                                    "textColor": "#8B85FF",
                                    "radius": 12,
                                    "paddingLeft": 16,
                                    "paddingRight": 16,
                                    "paddingTop": 8,
                                    "paddingBottom": 8
                                },
                                "placement": {
                                    "mode": "relative",
                                    "width": 104,
                                    "height": 36
                                },
                                "layout": {
                                    "type": "flex",
                                    "mainAlign": "center",
                                    "crossAlign": "center"
                                },
                                "children": [
                                    {
                                        "type": "label",
                                        "id": "rooms_shortcut_label",
                                        "commonProps": {
                                            "clickable": false
                                        },
                                        "labelProps": {
                                            "text": "Rooms"
                                        },
                                        "style": {
                                            "textColor": "#8B85FF",
                                            "fontSize": 13
                                        },
                                        "bindings": {
                                            "labelProps.text": "labelProps.text"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "container",
                        "id": "devices_body",
                        "commonProps": {
                            "scrollable": false,
                            "clickable": false
                        },
                        "placement": {
                            "mode": "relative",
                            "width": "match",
                            "height": 1,
                            "flexGrow": 1
                        },
                        "children": [
                            {
                                "type": "container",
                                "id": "devices_grid",
                                "commonProps": {
                                    "scrollable": true,
                                    "clickable": true,
                                    "hidden": true
                                },
                                "placement": {
                                    "mode": "absolute",
                                    "x": 0,
                                    "y": 0,
                                    "width": "match",
                                    "height": "match"
                                },
                                "layout": {
                                    "type": "flex",
                                    "flexFlow": "column",
                                    "mainAlign": "start",
                                    "crossAlign": "stretch",
                                    "gap": 12
                                },
                                "bindings": {
                                    "commonProps.hidden": "hidden"
                                }
                            },
                            {
                                "type": "container",
                                "id": "devices_empty",
                                "commonProps": {
                                    "scrollable": false,
                                    "clickable": false,
                                    "hidden": true
                                },
                                "bindings": {
                                    "commonProps.hidden": "hidden"
                                },
                                "style": {
                                    "bgColor": "#252545",
                                    "radius": 20,
                                    "padding": 24,
                                    "borderWidth": 1,
                                    "borderColor": "#3A3A60"
                                },
                                "placement": {
                                    "mode": "relative",
                                    "align": "center",
                                    "width": 420,
                                    "height": 150
                                },
                                "layout": {
                                    "type": "flex",
                                    "flexFlow": "column",
                                    "mainAlign": "center",
                                    "crossAlign": "center",
                                    "gap": 8
                                },
                                "children": [
                                    {
                                        "type": "label",
                                        "id": "empty_title",
                                        "labelProps": {
                                            "text": "No Matter devices yet"
                                        },
                                        "style": {
                                            "textColor": "#EAEAFF",
                                            "fontSize": 18
                                        },
                                        "bindings": {
                                            "labelProps.text": "text"
                                        }
                                    },
                                    {
                                        "type": "label",
                                        "id": "empty_desc",
                                        "labelProps": {
                                            "text": "Open Commissioning to add your first device."
                                        },
                                        "style": {
                                            "textColor": "#9292B8",
                                            "fontSize": 12
                                        },
                                        "bindings": {
                                            "labelProps.text": "text"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
