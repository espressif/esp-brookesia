    "type": "viewTemplate",
    "id": "file_entry",
    "node": {
        "type": "button",
        "commonProps": {
            "hidden": true,
            "pressLock": false
        },
        "bindings": {
            "commonProps.hidden": "commonProps.hidden"
        },
        "styleRefs": [
            "app.listItem"
        ],
        "style": {
            "padding": "0dp"
        },
        "events": [
            {
                "type": "clicked",
                "action": "files.entry.click"
            },
            {
                "type": "longPressed",
                "action": "files.entry.long"
            }
        ],
        "layout": {
            "type": "none"
        },
        "placement": {
            "mode": "flow",
            "width": "match",
            "height": "${constant.files.layout.entryHeight}",
            "alignSelf": "stretch"
        },
        "children": [
            {
                "type": "container",
                "id": "body",
                "commonProps": {
                    "clickable": false
                },
                "layout": {
                    "type": "grid",
                    "gridTemplateColumns": [
                        "${constant.files.layout.iconColumn}",
                        "match"
                    ],
                    "gridTemplateRows": [
                        "match"
                    ],
                    "gap": "10dp",
                    "crossAlign": "center"
                },
                "placement": {
                    "mode": "relative",
                    "align": "center",
                    "width": "match",
                    "height": "match"
                },
                "children": [
                    {
