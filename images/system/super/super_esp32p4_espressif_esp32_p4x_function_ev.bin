                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "gap": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "templateRef",
                            "id": "selected",
                            "templateId": "operation_item",
                            "overrides": {
                                ".": {
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "events": []
                                },
                                "chevron": {
                                    "labelProps": {
                                        "text": ""
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "label",
                    "id": "actions_caption",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "${constant.files.i18n.file_actions}"
                    }
                },
                {
                    "type": "container",
                    "id": "actions_card",
                    "commonProps": {
                        "scrollable": false
                    },
                    "styleRefs": [
                        "app.card"
                    ],
                    "style": {
                        "padding": "${constant.files.layout.cardPadding}"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "gap": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                       F␀␀ "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "templateRef",
                            "id": "rename",
