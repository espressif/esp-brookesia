    "type": "viewScreen",
    "id": "my_device",
    "mountMode": "dynamic",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": true
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.settings.layout.pageGap}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.settings.layout.pageX}",
                "y": "${constant.settings.layout.pageY}",
                "width": "${constant.settings.layout.pageWidth}",
                "height": "${constant.settings.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "container",
                    "id": "hero",
                    "style": {
                        "bgColor": "${color.primary.fill}",
                        "radius": "${constant.settings.layout.cardRadius}",
                        "padding": "${constant.settings.layout.cardPadding}"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "150dp",
                        "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "label",
