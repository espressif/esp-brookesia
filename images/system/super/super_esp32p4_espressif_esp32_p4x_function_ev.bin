                        },
                        "placement": {
                            "mode": "flow",
                            "gridColumn": 0,
                            "gridRow": 0,
                            "width": "${constant.files.layout.iconBox}",
                            "height": "${constant.files.layout.iconBox}",
                            "alignSelf": "center"
                        },
                        "imageProps": {
                            "src": "${image.files.icon.file}",
                            "innerAlign": "contain"
                        }
                    },
                    {
                        "type": "container",
                        "id": "content",
                        "commonProps": {
                            "clickable": false
                        },
                        "layout": {
                            "type": "flex",
                            "flexFlow": "column",
                            "mainAlign": "center",
                            "crossAlign": "start",
                            "gap": "3dp"
                        },
                        "placement": {
                            "mode": "flow",
                            "gridColumn": 1,
                            "gridRow": 0,
                            "alignSelf": "stretch"
                        },
                        "children": [
