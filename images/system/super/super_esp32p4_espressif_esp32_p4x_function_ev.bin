                    "type": "button",
                    "id": "back",
                    "commonProps": {
                        "hidden": true
                    },
                    "bindings": {
                        "commonProps.hidden": "commonProps.hidden"
                    },
                    "events": [
                        {
                            "type": "clicked",
                            "action": "settings.header.back"
                        }
                    ],
                    "interactionRefs": [
