                        ],
                        "labelProps": {
                            "text": ""
                        }
                    }
                ]
            },
            {
                "type": "label",
                "id": "chevron",
                "bindings": {
                    "labelProps.text": "labelProps.text"
                },
                "styleRefs": [
                    "app.listItemValue"
                ],
                "labelProps": {
                    "text": ">"
                },
