            "gridTemplateRows": [
                "match"
            ],
            "gap": "12dp",
            "crossAlign": "center"
        },
        "placement": {
            "mode": "flow",
            "width": "match",
            "height": "${constant.files.layout.operationItemHeight}",
            "alignSelf": "stretch"
        },
        "children": [
