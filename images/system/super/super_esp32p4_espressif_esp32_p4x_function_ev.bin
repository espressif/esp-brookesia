                    "id": "brightness_card",
                    "templateId": "settings_card",
                    "overrides": {
                        ".": {
                            "style": {
                                "padding": "${constant.settings.layout.cardPadding}"
                            },
                            "layout": {
                                "gap": "${constant.settings.layout.cardGap}"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": "wrap",
                                "alignSelf": "stretch"
                            }
                        }
                    },
                    "slots": {
                        "content": [
                            {
                                "type": "templateRef",
                                "id": "brightness_row",
                                "templateId": "slider_row",
                                "overrides": {
                                    "title": {
                                        "labelProps": {
                                            "text": "Screen brightness"
                                        }
                                    },
                                    "slider": {
                                        "events": [
                                            {
                                                "type": "valueChanged",
                                                "action": "settings.display.brightness"
                                            }
                                        ],
                                        "rangeProps": {
                                            "min": 0,
                                            "max": 100,
                                            "value": 72
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
