    "type": "viewTemplate",
    "id": "theme_mode_card",
    "node": {
        "type": "button",
        "events": [],
        "styleRefs": [
            "app.selectableCard"
        ],
        "style": {
            "padding": "18dp"
        },
        "layout": {
            "type": "flex",
            "flexFlow": "column",
            "mainAlign": "center",
            "crossAlign": "center",
            "gap": "10dp"
        },
        "placement": {
            "mode": "flow",
            "width": "${constant.settings.layout.themeModeCardWidth}",
            "height": "${constant.settings.layout.themeModeCardHeight}",
