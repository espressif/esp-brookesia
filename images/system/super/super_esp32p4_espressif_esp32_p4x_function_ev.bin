                {
                    "type": "container",
                    "id": "actions",
                    "commonProps": {
                        "scrollable": false
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "rowWrap",
                        "mainAlign": "end",
                        "crossAlign": "center",
                        "gap": "10dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "alignSelf": "stretch"
                    },
                    "children": [
