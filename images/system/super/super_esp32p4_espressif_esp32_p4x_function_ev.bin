                                    }
                                }
                            },
                            {
                                "type": "templateRef",
                                "id": "thread_idle",
                                "templateId": "debug_slider_row",
                                "overrides": {
                                    "title": {
                                        "labelProps": {
                                            "text": "Idle CPU %"
                                        }
                                    },
                                    "slider": {
                                        "events": [
                                            {
                                                "type": "valueChanged",
                                                "action": "settings.debug.thread.idle_cpu"
