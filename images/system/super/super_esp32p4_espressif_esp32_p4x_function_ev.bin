                                    ],
                                    "labelProps": {
                                        "text": "Cancel"
                                    },
                                    "placement": {
                                        "mode": "flow"
                                    },
                                    "bindings": {
                                        "labelPr”␀␀ops.text": "labelProps.text"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "button",
                            "id": "connect",
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.wifi.connect.submit"
                                }
                            ],
                            "bindings": {
                                "commonProps.disabled": "disabled",
                                "style.opacity": "opacity"
                            },
                            "styleRefs": [
                                "app.listItem"
                            ],
                            "style": {
                                "opacity": 96
                            },
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "${constant.settings.layout.wifiConnectActionWidth}",
                                "height": "${constant.settings.layout.smallRowHeight}"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "label",
                                    "commonProps": {
                                        "clickable": false
                                    },
                                    "styleRefs": [
                                        "app.listItemTitle"
                                    ],
                                    "labelProps": {
                                        "text": "Connect"
                                    },
                                    "placement": {
                                        "mode": "flow"
                                    },
                                    "bindings": {
