    "type": "viewScreen",
    "id": "overlay",
    "commonProps": {
        "clickable": false,
        "scrollable": false
    },
    "placement": {
        "mode": "absolute",
        "x": 0,
        "y": 0,
        "width": "${env.widthDp}",
        "height": "${env.heightDp}"
    },
    "style": {
        "padding": 0
    },
    "children": [
        {
            "type": "container",
            "id": "system_ui_mask",
            "commonProps": {
                "hidden": true,
                "clickable": true,
                "scrollable": false
            },
            "bindings": {
                "commonProps.hidden": "hidden"
            },
            "events": [
                {
                    "type": "clicked",
                    "action": "super.nav.mask.click"
                },
                {
                    "type": "gesture",
                    "action": "super.nav.mask.gesture"
                }
            ],
            "placement": {
                "mode": "absolute",
                "x": 0,
                "y": 0,
