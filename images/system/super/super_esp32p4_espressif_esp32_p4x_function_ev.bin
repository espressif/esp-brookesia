                        "gridRow": 0,
                        "alignSelf": "center"
                    }
                },
                {
                    "type": "container",
                    "id": "spacer",
                    "placement": {
                        "mode": "flow",
                        "gridColumn": 2,
                        "gridRow": 0,
                        "alignSelf": "stretch"
                    }
                }
            ]
        }
    ]
