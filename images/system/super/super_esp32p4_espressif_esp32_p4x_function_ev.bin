            "bgColor": "${color.text.muted}",
            "opacity": 144,
            "radius": "3dp"
        },
        "shell.debugPanel": {
            "bgColor": "${color.bg.overlay}",
            "borderColor": "${color.border.strong}",
            "borderWidth": "1dp",
            "radius": "6dp",
            "padding": "6dp",
            "opacity": "${constant.ui.overlay.metric.debugOverlayOpacity}"
        },
        "shell.debugTitle": {
            "textColor": "#f8fafc",
            "fontSize": "${constant.ui.overlay.metric.debugTitleFont}"
        },
        "shell.debugText": {
            "textColor": "#f8fafc",
            "fontSize": "${constant.ui.overlay.metric.debugTextFont}"
        },
        "shell.debugMetricChip": {
            "bgColor": "#111827",
            "radius": "4dp",
            "paddingLeft": "3dp",
            "paddingRight": "3dp"
        },
        "shell.debugMetricText": {
            "textColor": "#f8fafc",
            "fontSize": "${constant.ui.overlay.metric.debugTextFont}"
        },
        "shell.keyboardBackdrop": {
            "bgColor": "${color.bg.overlay}",
            "opacity": 96
        },
        "shell.keyboardPanel": {
            "bgColor": "${color.surface.base}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "18dp"
        },
        "shell.keyboardInput": {
            "bgColor": "${color.surface.muted}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "12dp",
            "textColor": "${color.text.default}"
        },
        "shell.keyboardInputField": {
            "bgColor": "${color.surface.base}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "10dp",
            "textColor": "${color.text.default}"
        },
        "shell.keyboardEyeButton": {
            "bgColor": "${color.surface.base}",
            "radius": "10dp"
        },
        "shell.keyboardKeyDefault": {
            "bgColor": "${color.surface.base}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "8dp",
            "textColor": "${color.text.default}",
            "stateStyles": {
                "pressed": {
                    "bgColor": "${color.surface.pressed}"
                }
            }
        },
        "shell.keyboardKeySpecial": {
            "bgColor": "${color.surface.base}",
            "borderColor": "${color.primary.fill}",
            "borderWidth": "1dp",
            "radius": "8dp",
            "textColor": "${color.text.default}",
            "stateStyles": {
                "pressed": {
                    "bgColor": "${color.primary.hover}",
                    "textColor": "${color.primary.on}"
                }
            }
        },
        "shell.keyboardKeyMode": {
            "bgColor": "${color.primary.fill}",
            "borderColor": "${color.primary.fill}",
            "borderWidth": "1dp",
            "radius": "8dp",
            "textColor": "${color.primary.on}",
            "stateStyles": {
                "pressed": {
                    "bgColor": "${color.primary.hover}"
                }
            }
        },
        "shell.keyboardKeyAction": {
            "bgColor": "${color.primary.fill}",
            "borderColor": "${color.primary.fill}",
            "borderWidth": "1dp",
            "radius": "8dp",
            "textColor": "${color.primary.on}",
            "stateStyles": {
                "pressed": {
                    "bgColor": "${color.primary.hover}"
      §␀␀¦␀␀          }
            }
        },
        "shell.keyboardKeyDisabled": {
            "bgColor": "${color.border.default}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "8dp",
            "textColor": "${color.text.subtle}",
            "opacity": 128
        },
        "shell.messageDialogBackdrop": {
            "bgColor": "${color.bg.overlay}",
            "opacity": 80
        },
        "system.appOverlayLaunchBackdrop": {
            "bgColor": "${color.bg.overlay}",
            "opacity": 88
        },
        "system.appOverlayLaunchSurface": {
            "bgColor": "${color.surface.base}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "0dp"
        },
        "system.appOverlayLaunchIconBox": {
            "bgColor": "${color.primary.soft}",
            "borderColor": "${color.primary.hover}",
            "borderWidth": "1dp",
            "radius": "24dp",
            "padding": "16dp"
        },
        "system.appOverlayLaunchFallbackIcon": {
            "textColor": "${color.primary.fill}",
            "fontSize": "42sp"
        },
        "system.appOverlayLoadingBackdrop": {
            "bgColor": "${color.bg.overlay}",
            "opacity": 168
        },
        "system.appOverlayLoadingIconBox": {
            "bgColor": "${color.primary.soft}",
            "borderColor": "${color.primary.hover}",
            "borderWidth": "1dp",
            "radius": "24dp",
            "padding": "16dp"
        },
        "shell.messageDialogPanel": {
            "bgColor": "${color.surface.base}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "18dp",
            "shadowWidth": "18dp",
            "shadowColor": "${color.bg.overlay}"
        },
        "shell.messageDialogText": {
            "textColor": "${color.text.default}",
            "fontSize": "18sp",
            "textAlign": "center"
        },
        "shell.messageDialogInformativeText": {
            "textColor": "${color.text.muted}",
            "fontSize": "14sp",
            "textAlign": "center"
        },
        "shell.messageDialogButton": {
            "bgColor": "${color.surface.muted}",
            "borderColor": "${color.border.default}",
            "borderWidth": "1dp",
            "radius": "8dp"
        },
        "shell.messageDialogButtonLabel": {
            "textColor": "${color.text.default}"
        }
    }
}
