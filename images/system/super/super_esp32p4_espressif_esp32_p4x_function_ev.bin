    "type": "viewScreen",
    "id": "settings_header",
    "commonProps": {
        "clickable": false,
        "scrollable": false
    },
    "style": {
        "paddingTop": "10dp",
        "padding": 0
    },
    "children": [
        {
            "type": "container",
            "id": "bar",
            "commonProps": {
                "scrollable": false
            },
            "styleRefs": [
                "app.page"
            ],
            "style": {
                "paddingLeft": "28dp",
                "paddingRight": "28dp",
                "paddingTop": "8dp",
                "paddingBottom": "8dp"
            },
            "layout": {
                "type": "grid",
                "gridTemplateColumns": [
                    "${constant.settings.layout.headerSideWidth}",
                    "match",
                    "${constant.settings.layout.headerSideWidth}"
                ],
                "gridTemplateRows": [
                    "match"
                ],
                "crossAlign": "center"
            },
            "placement": {
                "mode": "absolute",
                "x": 0,
                "y": 0,
                "width": "match",
                "height": "${constant.settings.layout.headerHeight}"
            },
            "children": [
