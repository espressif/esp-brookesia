                                "mode": "absolute",
                                "x": "0dp",
                                "y": "0dp",
                                "width": "wrap",
                                "height": "wrap"
                            },
                            "bindings": {
                                "labelProps.text": "labelProps.text"
                            }
                        },
                        {
                            "type": "container",
                            "id": "hero_content",
                            "layout": {
                                "type": "flex",
                                "flexFlow": "column",
                                "mainAlign": "center",
                                "crossAlign": "center",
                                "gap": "8dp"
                            },
                            "placement": {
                                "mode": "absolute",
                                "x": "0dp",
                                "y": "0dp",
                                "width": "match",
                                "height": "match"
                            },
                            "children": [
                                {
                                    "type": "label",
                                    "id": "os",
                                    "style": {
                                        "textColor": "${color.primary.on}",
                                        "fontSize": "${constant.settings.font.hero}"
                                    },
                                    "labelProps": {
                                        "text": "System"
                                    },
                                    "placement": {
                                        "mode": "flow"
                                    },
                                    "bindings": {
                                        "labelProps.text": "labelProps.text"
                                    }
          ֳ␀␀␀                      },
