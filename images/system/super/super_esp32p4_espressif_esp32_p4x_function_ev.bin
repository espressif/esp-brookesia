                "themePreviewWidth": "150dp",
                "themePreviewHeight": "58dp",
                "wifiMetaColumn": "36dp",
                "wifiRefreshColumnWidth": "44dp",
                "wifiRefreshSize": "34dp",
                "wifiHeaderHeight": "34dp",
                "wifiStatusCardHeight": "68dp",
                "wifiConnectedHeight": "74dp",
                "wifiRowHeight": "62dp",
                "wifiPasswordLabelColumn": "92dp",
                "wifiConnectActionWidth": "96dp"
