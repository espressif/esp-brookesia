                    ],
                    "styleRefs": [
                        "app.listItem"
                    ],
                    "style": {
                        "borderWidth": "0dp"
                    },
                    "layout": {
                        "type": "flex",
                        "mainAlign": "center",
                        "crossAlign": "center"
                    },
                    "placement": {
