                                        ],
                                        "placement": {
                                            "mode": "flow",
                                            "width": "match",
                                            "height": "${constant.settings.layout.rowHeight}",
                                            "alignSelf": "stretch"
                                        }
                                    },
                                    "icon": {
                                        "imageProps": {
                                            "src": "${image.home.my_device}"
                                        },
                                        "style": {
                                            "bgColor": "${color.info.soft}"
                                        }
                                    },
                                    "title_box/title": {
                                        "labelProps": {
                                            "text": "My device"
                                        }
                                    },
                                    "value_box/value": {
                                        "labelProps": {
                                            "text": ""
                                        }
                                    }
                                }
                            }
                        ]
                    }
                },
                {
