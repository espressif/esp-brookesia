Fix frame-mode video capture shutdown and source cleanup in av_processor 0.6.x.

Frame mode owns an active esp_capture handle without setting is_running. Treat
that handle as active so video_capture_stop() and video_capture_close() both
tear the pipeline down through the public stop path. The V4L2 source returned
by esp_capture_new_video_v4l2_src() is caller-owned, so release it after the
capture pipeline closes and on every failed start path without destroying the
persistent stream-mode queue objects.

--- a/src/video_processor.c
+++ b/src/video_processor.c
@@ -124,7 +124,7 @@
     SAFE_CLEANUP(render->event_group, vEventGroupDelete);
 }

-static void video_capture_cleanup(video_capture_t *capture)
+static void video_capture_pipeline_cleanup(video_capture_t *capture)
 {
     if (!capture) {
         return;
@@ -133,13 +133,26 @@
         esp_capture_stop(capture->capture);
         SAFE_CLEANUP(capture->capture, esp_capture_close);
     }
+    for (int i = 0; i < DEFAULT_VID_MAX_PATH; i++) {
+        capture->sink[i] = NULL;
+    }
+    capture->capture_thread = NULL;
+    SAFE_CLEANUP(capture->vid_src, esp_gmf_oal_free);
+    capture->aud_src = NULL;
+}
+
+static void video_capture_cleanup(video_capture_t *capture)
+{
+    if (!capture) {
+        return;
+    }
+    video_capture_pipeline_cleanup(capture);
     if (capture->config.stream_mode && capture->frame_queue) {
         SAFE_CLEANUP(capture->frame_queue, vQueueDelete);
     }
     if (capture->config.stream_mode && capture->event_group) {
         SAFE_CLEANUP(capture->event_group, vEventGroupDelete);
     }
-    capture->vid_src = NULL;
 }

