+/* ESP_CAPTURE_FMT_ID_YUV422 means YUYV downstream, so a device that only offers
+ * UYVY has to be captured as UYVY and byte swapped afterwards. */
+static bool yuv422_needs_swap(v4l2_src_t *v4l2)
+{
+    return v4l2->has_uyvy && !v4l2->has_yuyv;
+}
+
+static uint32_t get_v4l2_pixel_format(v4l2_src_t *v4l2, esp_capture_format_id_t codec)
+{
+    if ((codec == ESP_CAPTURE_FMT_ID_YUV422) && yuv422_needs_swap(v4l2)) {
+        return V4L2_PIX_FMT_UYVY;
+    }
+    return get_v4l2_type(codec);
+}

