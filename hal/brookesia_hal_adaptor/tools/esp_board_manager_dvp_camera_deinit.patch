Preserve DVP ownership and report staged cleanup errors in Board Manager 0.5.15.

Video-close errors are retryable. Once video has closed, release its I2C reference
exactly once; uncertain peripheral failures become terminal and retain the camera
wrapper and slot dependencies. Generic camera error propagation changes DVP only.

--- a/devices/dev_camera/dev_camera.c
+++ b/devices/dev_camera/dev_camera.c
@@ -5,6 +5,7 @@
  * See LICENSE file for details.
  */

+#include <string.h>
 #include "esp_log.h"
 #include "dev_camera.h"
 #include "esp_board_device.h"
@@ -56,7 +57,10 @@
             int ret = desc->deinit_func(device_handle);
             if (ret != 0) {
                 ESP_LOGE(TAG, "Sub device '%s' deinit failed with error: %d", cfg->sub_type, ret);
-                // Continue with cleanup even if deinit failed
+                // DVP retains its wrapper and dependencies until cleanup completes.
+                if (strcmp(cfg->sub_type, "dvp") == 0) {
+                    return ret;
+                }
             } else {
                 ESP_LOGI(TAG, "Sub device '%s' deinitialized successfully", cfg->sub_type);
             }
--- a/devices/dev_camera/dev_camera_sub_dvp.c
+++ b/devices/dev_camera/dev_camera_sub_dvp.c
@@ -6,6 +6,7 @@
  */

 #include <string.h>
+#include <stdbool.h>
 #include "esp_log.h"
 #include "esp_video_init.h"
 #include "dev_camera.h"
@@ -15,6 +16,14 @@
 #include "esp_video_device.h"

 static const char *TAG = "DEV_CAMERA_SUB_DVP";
+
+/* Keep stage and ownership private; dev_camera_handle_t remains unchanged. */
+typedef struct {
+    dev_camera_handle_t base;
+    const char *i2c_name;
+    bool video_closed;
+    esp_err_t cleanup_error;
+} dvp_camera_runtime_t;

 int dev_camera_sub_dvp_init(void *cfg, int cfg_size, void **device_handle)
 {
@@ -44,7 +53,7 @@
     const esp_video_init_config_t cam_config = {
         .dvp = &s_dvp_config,
     };
-    dev_camera_handle_t *handle = calloc(1, sizeof(dev_camera_handle_t));
+    dvp_camera_runtime_t *handle = calloc(1, sizeof(*handle));
     if (handle == NULL) {
         ESP_LOGE(TAG, "Failed to allocate memory");
         goto cleanup;
@@ -56,34 +65,50 @@
         goto cleanup;
     }

-    handle->dev_path = ESP_VIDEO_DVP_DEVICE_NAME;
+    handle->base.dev_path = ESP_VIDEO_DVP_DEVICE_NAME;
+    handle->i2c_name = config->sub_cfg.dvp.i2c_name;
     *device_handle = handle;
-    ESP_LOGI(TAG, "DVP camera initialized successfully, dev_path: %s", handle->dev_path);
+    ESP_LOGI(TAG, "DVP camera initialized successfully, dev_path: %s", handle->base.dev_path);
     return 0;
 cleanup:
-    esp_board_periph_unref_handle(config->sub_cfg.dvp.i2c_name);
+    ret = esp_board_periph_unref_handle(config->sub_cfg.dvp.i2c_name);
+    if (ret != ESP_OK) {
+        ESP_LOGE(TAG, "DVP init rollback failed; I2C isolated: %s", esp_err_to_name(ret));
+    }
     return -1;
 }

 int dev_camera_sub_dvp_deinit(void *device_handle)
 {
-    dev_camera_handle_t *handle = (dev_camera_handle_t *)device_handle;
-    ESP_LOGI(TAG, "Deinitializing DVP camera...");
-
-    // Deinitialize DVP camera
-    // In the current version of esp_video(1.4.0), it will deinit all cameras that have been initialized
-    esp_err_t ret = esp_video_deinit();
-    if (ret != ESP_OK) {
